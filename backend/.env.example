# GridBricks Wind Forecast Analytics Platform Configuration
APP_NAME="GridBricks Wind Forecast Analytics API"
DEBUG=false

# Elexon BMRS API
ELEXON_BASE_URL="https://data.elexon.co.uk/bmrs/api/v1"
REQUEST_TIMEOUT_SECONDS=35.0

# Day-Ahead Decision Cutoff
# Default: 12 (Midday 12:00 Europe/London on day D-1)
DEFAULT_DECISION_HOUR=12

# In-Memory Cache Size
CACHE_MAX_SIZE=8

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"

